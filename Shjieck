local function isMyGunPart(container)
	local character = Player.Character
	if character and container:IsDescendantOf(character) then return true end
	
	local bp = Player:FindFirstChild("Backpack")
	if bp and container:IsDescendantOf(bp) then return true end
	
	if container:IsDescendantOf(Workspace.CurrentCamera) then return true end
	
	if getOwnerFromAttributes(container, 5) then return true end
	if getOwnerFromValueChildren(container) then return true end
	
	if character then
		for _, v in ipairs(container:GetDescendants()) do
			if v:IsA("Weld") or v:IsA("Motor6D") or v:IsA("WeldConstraint") then
				if v.Part0 and v.Part0:IsDescendantOf(character) then return true end
				if v.Part1 and v.Part1:IsDescendantOf(character) then return true end
			end
		end
		
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			local part = container:IsA("BasePart") and container or container:FindFirstChildWhichIsA("BasePart", true)
			if part then
				local dist = (part.Position - root.Position).Magnitude
				if dist < 12 then
					local closest = Player
					local minDist = dist
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
							local d2 = (part.Position - p.Character.HumanoidRootPart.Position).Magnitude
							if d2 < minDist then
								closest = p
								minDist = d2
							end
						end
					end
					if closest == Player then return true end
				end
			end
		end
	end
	
	return false
end

local function getMyWeaponContainers()
	local containers = {}
	
	local function addIfMine(child)
		if child.Name == "Gun" or child.Name == "GunDisplay" or child.Name == "DisplayRefGun" then
			if isMyGunPart(child) then
				table.insert(containers, child)
			end
		end
	end
	
	if Player.Character then
		for _, child in ipairs(Player.Character:GetDescendants()) do
			addIfMine(child)
		end
	end
	
	if Player:FindFirstChild("Backpack") then
		for _, child in ipairs(Player.Backpack:GetDescendants()) do
			addIfMine(child)
		end
	end
	
	for _, child in ipairs(Workspace.CurrentCamera:GetDescendants()) do
		addIfMine(child)
	end
	
	for _, child in ipairs(Workspace:GetChildren()) do
		addIfMine(child)
		if child:IsA("Folder") or child:IsA("Model") then
			for _, sub in ipairs(child:GetChildren()) do
				addIfMine(sub)
			end
		end
	end
	
	return containers
end

local function scanMyGunsAndApply()
	local containers = getMyWeaponContainers()
	for _, container in ipairs(containers) do
		if isTextureLike(container) and not targetObjects[container] then
			targetObjects[container] = true
			table.insert(targets, {Object = container})
		end
		for _, desc in ipairs(container:GetDescendants()) do
			if isTextureLike(desc) and not targetObjects[desc] then
				targetObjects[desc] = true
				table.insert(targets, {Object = desc})
			end
		end
	end
	apply()
end

local function isMyBeam(obj)
	if Player.Character and obj:IsDescendantOf(Player.Character) then return true end
	local backpack = Player:FindFirstChild("Backpack")
