local function drawNeonLaser(origin, endPos)
    local distance = (endPos - origin).Magnitude
    if distance < 0.1 then return end

    local activeColor, activeRainbow = getActiveTrail()
    if not activeColor and not activeRainbow then return end

    local SEGMENTS = math.clamp(math.floor(distance / 4), 4, 14)
    local dir = (endPos - origin).Unit

    local segments = {}
    for i = 1, SEGMENTS do
        local t0 = (i - 1) / SEGMENTS
        local t1 = i / SEGMENTS
        local a = origin + dir * (distance * t0)
        local b = origin + dir * (distance * t1)
        local segLen = (b - a).Magnitude

        local seg = Instance.new("Part")
        seg.Name = "NeonLaserTrail"
        seg.Anchored = true
        seg.CanCollide = false
        seg.CanQuery = false
        seg.CanTouch = false
        seg.Material = Enum.Material.Neon
        seg.Size = Vector3.new(0.22, 0.22, segLen)
        seg.CFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -segLen / 2)
        seg.Transparency = 1
        seg.Color = activeColor or Color3.new(1, 1, 1)
        seg.Parent = Workspace
        
        for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Left, Enum.NormalId.Right}) do
            local tex = Instance.new("Texture")
            tex.Texture = "rbxassetid://1885993498"
            tex.Face = face
            tex.Parent = seg
        end

        table.insert(segments, {Part = seg, Index = i, Length = segLen})
    end

    local TOTAL = #segments
    local GROW_TIME = 0.025
    local FADE_TIME = 0.12
    local STEP = 0.004

    local startTime = tick()
    local conn

    conn = RunService.RenderStepped:Connect(function()
        local now = tick() - startTime
        local allGone = true
        
        local rapidRainbowColor = Color3.fromHSV((tick() * 5) % 1, 1, 1)

        for _, data in ipairs(segments) do
            local seg = data.Part
            if seg.Parent then
                allGone = false

                local tPos = (data.Index - 1) / math.max(TOTAL - 1, 1)
                local growT = math.clamp((now - tPos * GROW_TIME) / 0.015, 0, 1)
                local fadeDelay = tPos * (TOTAL * STEP)
                local fadeT = math.clamp((now - GROW_TIME - fadeDelay) / FADE_TIME, 0, 1)

                local alpha = 1 - fadeT
                local visibility = growT * alpha

                if activeRainbow then
                    seg.Color = rapidRainbowColor
                end

                seg.Transparency = 1 - visibility
                local shrink = 1 - fadeT * 0.6
                seg.Size = Vector3.new(0.22 * shrink, 0.22 * shrink, data.Length)

                if fadeT >= 1 then
                    seg:Destroy()
                end
            end
        end

        if allGone then
            if conn then conn:Disconnect() end
        end
    end)
end

local LASER_KEYWORDS = {"beam", "laser", "trail", "tracer", "shot", "line", "ray", "disparo", "bala"}
local function looksLikeShotBeam(beam)
    if not beam:IsA("Beam") then return false end
    local name = string.lower(beam.Name)
    for _, kw in ipairs(LASER_KEYWORDS) do
        if string.find(name, kw) then return true end
    end
    return false
end

local KNIFE_KEYWORDS = {"knife", "sword", "blade", "dagger", "cuchillo", "daga", "katana", "sable"}
local function isKnifeObj(obj)
    local c = obj
    while c and c ~= game do
        if c:IsA("Tool") then
            local n = string.lower(c.Name)
            for _, kw in ipairs(KNIFE_KEYWORDS) do
                if string.find(n, kw, 1, true) then return true end
            end
            return false
        end
        c = c.Parent
    end
    return false
end

local function getBeamEndpoints(beam)
    local a0 = beam.Attachment0
    local a1 = beam.Attachment1

    if a0 and a1 then
        return a0.WorldPosition, a1.WorldPosition
    elseif a0 then
        local o = a0.WorldPosition
        return o, o + a0.WorldCFrame.LookVector * 200
    elseif a1 then
        local e = a1.WorldPosition
        return e - a1.WorldCFrame.LookVector * 200, e
    end

    local parent = beam.Parent
    if parent and parent:IsA("BasePart") then
        local o = parent.Position
        return o, o + parent.CFrame.LookVector * 200
    end

    return nil, nil
end

local function replaceBeamWithLaser(beam)
    if not beam or not beam.Parent then return end
    if not looksLikeShotBeam(beam) then return end

    if not (states.MatrixScope or states.VoidScope) then return end

    -- Ignorar cuchillos
    if isKnifeObj(beam) then return end
    
    -- Detectar si está cerca o es mío
    if not isNearOrMine(beam) then return end

    local origin, endPos = getBeamEndpoints(beam)
    beam:Destroy()

    if origin and endPos then
        drawNeonLaser(origin, endPos)
    end
end

