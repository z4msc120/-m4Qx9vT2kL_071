	if not states.MatrixScope and not states.VoidScope then return end
	local activeColor, activeRainbow = getActiveTrail()
	if not activeColor and not activeRainbow then return end

	if Player.Character then
		for _, obj in ipairs(Player.Character:GetDescendants()) do
			if obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") or SHOT_NAMES[obj.Name] then
				if isMyWeapon(obj) then colorBeamOrPart(obj, activeColor, activeRainbow) end
			end
		end
	end

	if Camera then
		for _, obj in ipairs(Camera:GetDescendants()) do
			if obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") or SHOT_NAMES[obj.Name] then
				if isMyWeapon(obj) then colorBeamOrPart(obj, activeColor, activeRainbow) end
			end
		end
	end
	
	if nearestDisplayCache then
		for _, obj in ipairs(nearestDisplayCache:GetDescendants()) do
			if obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") or SHOT_NAMES[obj.Name] then
				colorBeamOrPart(obj, activeColor, activeRainbow)
			end
		end
	end
end)

local function findShotContainer(object)
    if SHOT_NAMES[object.Name] then return object end
    if object.Parent and SHOT_NAMES[object.Parent.Name] then return object.Parent end
    return nil
end

Workspace.DescendantAdded:Connect(function(object)
	processIfTexture(object)
	
	if not states.MatrixScope and not states.VoidScope then return end
	task.defer(function()
		if not object.Parent then return end
		
		local shot = findShotContainer(object)
		if shot then
			local ownerId = shot:GetAttribute("OwnerUserId")
			local isOurs = false
			
			if ownerId == Player.UserId then
				isOurs = true
			elseif ownerId == nil then
				local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
				if root then
					local pos = nil
					if object:IsA("BasePart") then pos = object.Position
					elseif object:IsA("Attachment") then pos = object.WorldPosition
					elseif object:IsA("Beam") and object.Attachment0 then pos = object.Attachment0.WorldPosition 
					elseif object:IsA("Trail") and object.Attachment0 then pos = object.Attachment0.WorldPosition end
					
					if pos and (pos - root.Position).Magnitude < 15 then
						isOurs = true
					end
				end
			end
			
			if isOurs then
				local activeColor, activeRainbow = getActiveTrail()
				colorBeamOrPart(shot, activeColor, activeRainbow)
				for _, desc in ipairs(shot:GetDescendants()) do
					colorBeamOrPart(desc, activeColor, activeRainbow)
				end
			end
		end
	end)
end)

