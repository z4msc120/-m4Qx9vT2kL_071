local RGB_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
})

local function sequencesMatch(seq1, seq2)
	local ok, result = pcall(function()
		if type(seq1) ~= typeof(seq2) then return false end
		if not seq1 or not seq2 then return false end
		local k1, k2 = seq1.Keypoints, seq2.Keypoints
		if #k1 ~= #k2 then return false end
		for i = 1, #k1 do
			if k1[i].Value ~= k2[i].Value or k1[i].Time ~= k2[i].Time then return false end
		end
		return true
	end)
	return ok and result
end

local function colorBeamOrPart(obj, color1, color2, rainbow)
	pcall(function()
		if obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") then
			local targetColor
			if rainbow then
				targetColor = RGB_SEQUENCE
			elseif color1 and color2 then
				targetColor = ColorSequence.new({
					ColorSequenceKeypoint.new(0.0, color1),
					ColorSequenceKeypoint.new(1.0, color2)
				})
			elseif color1 then
				targetColor = ColorSequence.new(color1)
			end
			if targetColor then
				if not sequencesMatch(obj.Color, targetColor) then
					saveOriginal(obj, "Color")
					obj.Color = targetColor
				end
			end
			if (obj:IsA("Beam") or obj:IsA("Trail")) and obj.Texture ~= "" then
				saveOriginal(obj, "Texture")
				obj.Texture = ""
			end
		elseif obj:IsA("BasePart") then
			if rainbow then
				local newC = Color3.fromHSV(tick() % 5 / 5, 1, 1)
				if obj.Color ~= newC then
					saveOriginal(obj, "Color")
					obj.Color = newC
				end
			elseif color1 then
				if obj.Color ~= color1 then
					saveOriginal(obj, "Color")
					obj.Color = color1
				end
			end
		end
	end)
end

local trackedShots = {}

local function tryTrackShot(obj)
	if not (obj:IsA("Beam") or obj:IsA("Trail")) then return end
	if trackedShots[obj] then return end
	trackedShots[obj] = true
end

Workspace.DescendantAdded:Connect(function(object)
	pcall(function()
		tryTrackShot(object)
		if object:IsA("Model") or object:IsA("Folder") then
			for _, desc in ipairs(object:GetDescendants()) do
				tryTrackShot(desc)
			end
		end
		if activeMode ~= "None" and (object:IsA("Beam") or object:IsA("Trail")) then
			local c1, c2, rb = getActiveTrail()
			if isMyBeam(object) then
				colorBeamOrPart(object, c1, c2, rb)
			end
			task.spawn(function()
				for i = 1, 6 do
					if not object.Parent then break end
					pcall(function()
						if isMyBeam(object) then
							colorBeamOrPart(object, c1, c2, rb)
						end
					end)
					RunService.Heartbeat:Wait()
				end
			end)
		end
	end)
end)

RunService.RenderStepped:Connect(function()
	pcall(function()
		for obj in pairs(trackedShots) do
			if not obj.Parent then trackedShots[obj] = nil end
		end
		if activeMode == "None" then return end
		local color1, color2, rainbow = getActiveTrail()
		for obj in pairs(trackedShots) do
			if obj.Parent and isMyBeam(obj) then
				colorBeamOrPart(obj, color1, color2, rainbow)
			end
		end
	end)
end)

Player.CharacterAdded:Connect(function(char)
	task.spawn(function()
		char:WaitForChild("HumanoidRootPart", 5)
		for i = 1, 10 do
			task.wait(0.5)
			if activeMode ~= "None" then
				pcall(scanMyGunsAndApply)
			end
		end
	end)
end)

task.spawn(function()
	while task.wait(1) do
		pcall(function()
			if activeMode ~= "None" then
				scanMyGunsAndApply()
			end
		end)
	end
end)

task.spawn(function()
	while task.wait(10) do
		pcall(function()
			for obj in pairs(originalProperties) do
				if not obj.Parent then
					originalProperties[obj] = nil
				end
			end
		end)
	end
end)
