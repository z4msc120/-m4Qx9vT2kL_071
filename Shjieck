local function createCustomBeamLayer(parent, attachment0, attachment1, settings)
	local beam = Instance.new("Beam")
	beam.Name = settings.Name or "BeamLayer"; beam.Attachment0 = attachment0; beam.Attachment1 = attachment1
	beam.FaceCamera = true; beam.LightEmission = 1; beam.LightInfluence = 0; beam.Width0 = settings.Width; beam.Width1 = settings.Width
	beam.Texture = CUSTOM_BEAM_TEXTURE; beam.TextureMode = Enum.TextureMode.Wrap; beam.TextureLength = settings.TextureLength or 2; beam.TextureSpeed = settings.TextureSpeed or 4
	beam.Color = settings.Color; beam.Transparency = NumberSequence.new(settings.Transparency); beam.Segments = 12; beam.ZOffset = settings.ZOffset or 0; beam.Parent = parent
	return beam
end

local function drawCustomBeam(origin, endPos, origBeam)
	local distance = (endPos - origin).Magnitude
	if distance < 0.1 then return end
	local activeColorSeq, activeRainbow = getActiveTrail()
	if not activeColorSeq and not activeRainbow then return end
	local beamColor
	if activeRainbow then beamColor = ColorSequence.new(Color3.fromHSV((tick() * 5) % 1, 1, 1))
	elseif typeof(activeColorSeq) == "ColorSequence" then beamColor = activeColorSeq
	else beamColor = ColorSequence.new(activeColorSeq) end
	local customBeam = Instance.new("Folder"); customBeam.Name = "CustomBeam"; customBeam.Parent = Workspace.Terrain
	local attachment0 = Instance.new("Attachment"); attachment0.Name = "CustomBeamStart"; attachment0.WorldPosition = origin; attachment0.Parent = Workspace.Terrain
	local attachment1 = Instance.new("Attachment"); attachment1.Name = "CustomBeamEnd"; attachment1.WorldPosition = endPos; attachment1.Parent = Workspace.Terrain
	local outerGlow = createCustomBeamLayer(customBeam, attachment0, attachment1, {Name = "OuterGlow", Width = 0.25, Transparency = 0.85, Color = beamColor, TextureLength = 2.5, TextureSpeed = 3, ZOffset = -0.03})
	local middleGlow = createCustomBeamLayer(customBeam, attachment0, attachment1, {Name = "MiddleGlow", Width = 0.12, Transparency = 0.50, Color = beamColor, TextureLength = 2, TextureSpeed = 4, ZOffset = -0.01})
	local core = createCustomBeamLayer(customBeam, attachment0, attachment1, {Name = "Core", Width = 0.05, Transparency = 0, Color = beamColor, TextureLength = 1.5, TextureSpeed = 5, ZOffset = 0})
	table.insert(activeBeams, {Folder = customBeam, Attach0 = attachment0, Attach1 = attachment1, Outer = outerGlow, Middle = middleGlow, Core = core, StartTime = tick(), IsRainbow = activeRainbow})
end

