local function matchesPlayerValue(val)
	if val == nil then return false end
	if typeof(val) == "Instance" and val == Player then return true end
	if typeof(val) == "number" and val == Player.UserId then return true end
	if typeof(val) == "string" then
		if string.lower(val) == string.lower(Player.Name) then return true end
		if tonumber(val) == Player.UserId then return true end
	end
	return false
end

local function getOwnerFromAttributes(obj, maxDepth)
	local check = obj
	for _ = 1, maxDepth or 5 do
		if not check or check == game then break end
		for _, attrName in ipairs(OWNER_ATTRS) do
			if matchesPlayerValue(check:GetAttribute(attrName)) then return true end
		end
		check = check.Parent
	end
	return false
end

local function getOwnerFromValueChildren(obj)
	local check = obj
	for _ = 1, 3 do
		if not check or check == game then break end
		for _, child in ipairs(check:GetChildren()) do
			if child:IsA("ObjectValue") then
				local v = child.Value
				if v == Player then return true end
				if v and v:IsA("Model") and Players:GetPlayerFromCharacter(v) == Player then return true end
			elseif child:IsA("StringValue") then
				if string.lower(child.Value) == string.lower(Player.Name) then return true end
				if tonumber(child.Value) == Player.UserId then return true end
			elseif child:IsA("IntValue") or child:IsA("NumberValue") then
				if child.Value == Player.UserId then return true end
			end
		end
		check = check.Parent
	end
	return false
end

local function setTexture(obj, id)
	local value = "rbxassetid://" .. id
	pcall(function()
		if obj:IsA("MeshPart") then
			saveOriginal(obj, "TextureID")
			if obj.TextureID ~= value then obj.TextureID = value end
		elseif obj:IsA("SpecialMesh") then
			saveOriginal(obj, "TextureId")
			if obj.TextureId ~= value then obj.TextureId = value end
		elseif obj:IsA("SurfaceAppearance") then
			saveOriginal(obj, "ColorMap")
			if obj.ColorMap ~= value then obj.ColorMap = value end
		elseif obj:IsA("Texture") or obj:IsA("Decal") then
			saveOriginal(obj, "Texture")
			if obj.Texture ~= value then obj.Texture = value end
		end
	end)
end

local function apply()
	local texId = nil
	if activeMode == "MatrixScope" then
		texId = selectedTextureMatrix
	elseif activeMode == "VoidScope" then
		texId = selectedTextureVoid
	end
	
	for i = #targets, 1, -1 do
		local data = targets[i]
		if not data.Object or not data.Object.Parent then
			if data.Object then targetObjects[data.Object] = nil end
			table.remove(targets, i)
		elseif texId then
			setTexture(data.Object, texId)
		else
			restoreObject(data.Object)
		end
	end
end

