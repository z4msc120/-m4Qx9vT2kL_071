for name in pairs(SHOT_NAMES) do
	SHOT_NAMES_LOWER[string.lower(name)] = true
end

local function isShotName(name)
	local lowerName = string.lower(name)
	if SHOT_NAMES_LOWER[lowerName] then return true end
	for shotName in pairs(SHOT_NAMES_LOWER) do
		if #lowerName > #shotName and string.sub(lowerName, 1, #shotName) == shotName then
			return true
		end
	end
	return false
end

local originalProperties = {}

local function saveOriginal(object, property)
	originalProperties[object] = originalProperties[object] or {}
	local properties = originalProperties[object]
	if properties[property] == nil then
		local ok, value = pcall(function() return object[property] end)
		if ok then properties[property] = value end
	end
end

local function restoreObject(object)
	local properties = originalProperties[object]
	if not properties or not object.Parent then return end
	for property, value in pairs(properties) do
		pcall(function() object[property] = value end)
	end
end

