	if obj:IsA("Beam") or obj:IsA("Trail") then
		if Player.Character then
			local att0 = obj.Attachment0
			local att1 = obj.Attachment1
			if att0 and att0:IsDescendantOf(Player.Character) then return true end
			if att1 and att1:IsDescendantOf(Player.Character) then return true end
		end
	end
	return false
end

