local MAX_BEAM_DISTANCE = 18

local function isNearOrMine(obj)
    if Player.Character and obj:IsDescendantOf(Player.Character) then return true end
    if Player:FindFirstChild("Backpack") and obj:IsDescendantOf(Player:FindFirstChild("Backpack")) then return true end
    if Player:FindFirstChild("PlayerGui") and obj:IsDescendantOf(Player:FindFirstChild("PlayerGui")) then return true end
    if obj:IsDescendantOf(ReplicatedStorage) then return true end

    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local pos
    if obj:IsA("BasePart") then
        pos = obj.Position
    elseif obj:IsA("Beam") or obj:IsA("Trail") then
        local a0 = obj.Attachment0
        local a1 = obj.Attachment1
        if a0 and (a0.WorldPosition - hrp.Position).Magnitude <= MAX_BEAM_DISTANCE then return true end
        if a1 and (a1.WorldPosition - hrp.Position).Magnitude <= MAX_BEAM_DISTANCE then return true end
        if obj.Parent and obj.Parent:IsA("BasePart") then
            pos = obj.Parent.Position
        end
    elseif obj:IsA("Attachment") and obj.Parent and obj.Parent:IsA("BasePart") then
        pos = obj.WorldPosition
    elseif obj:IsA("Decal") or obj:IsA("Texture") then
        local parent = obj.Parent
        if parent and parent:IsA("BasePart") then
            pos = parent.Position
        end
    end

    if pos and (pos - hrp.Position).Magnitude <= MAX_BEAM_DISTANCE then
        return true
    end
    return false
end

local function getId(v)
    return tostring(v or ""):match("%d+")
end

local function getTexture(obj)
    if obj:IsA("Texture") or obj:IsA("Decal") then
        return getId(obj.Texture)
    elseif obj:IsA("MeshPart") then
        return getId(obj.TextureID)
    elseif obj:IsA("SpecialMesh") then
        return getId(obj.TextureId)
    elseif obj:IsA("SurfaceAppearance") then
        return getId(obj.ColorMap)
    end
end

local function setTexture(obj, id)
    local value = "rbxassetid://" .. id
    if obj:IsA("Texture") or obj:IsA("Decal") then
        obj.Texture = value
    elseif obj:IsA("MeshPart") then
        obj.TextureID = value
    elseif obj:IsA("SpecialMesh") then
        obj.TextureId = value
    elseif obj:IsA("SurfaceAppearance") then
        obj.ColorMap = value
    end
end

local function findScope(obj)
    local id = getTexture(obj)
    for scope, originalId in pairs(ORIGINAL_IDS) do
        if id == originalId then return scope end
    end
end

local function register(obj)
    if not isNearOrMine(obj) then return end
    local scope = findScope(obj)
    if not scope then return end
    for _, data in ipairs(targets[scope]) do
        if data.Object == obj then return end
    end
    table.insert(targets[scope], {Object = obj, Original = ORIGINAL_IDS[scope]})
end

local function apply(scope)
    local texId
    if scope == "MatrixScope" then
        texId = selectedTextureMatrix
    else
        texId = selectedTextureVoid
    end

    for i = #targets[scope], 1, -1 do
        local data = targets[scope][i]
        local obj = data.Object
        if not obj or not obj.Parent then
            table.remove(targets[scope], i)
        elseif states[scope] then
            setTexture(obj, texId)
        else
            setTexture(obj, data.Original)
        end
    end
end

