local nearestDisplayCache = nil

local function processIfTexture(obj)
	if obj:IsA("MeshPart") or obj:IsA("SpecialMesh") or obj:IsA("SurfaceAppearance") or obj:IsA("Texture") or obj:IsA("Decal") then
		task.defer(function()
			local scope = register(obj)
			if scope and (states.MatrixScope or states.VoidScope) then apply(scope) end
		end)
	end
end

local function updateNearestDisplay()
    local character = Player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local nearest, nearestDistance = nil, 10
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object.Name == "GunDisplay" or object.Name == "DisplayRefGun" then
            local part
            if object:IsA("BasePart") then part = object
            elseif object:IsA("Model") then part = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
            elseif object:IsA("Tool") then part = object:FindFirstChild("Handle", true) end
            
            if part and part:IsA("BasePart") then
                local distance = (part.Position - root.Position).Magnitude
                if distance < nearestDistance then 
                    nearestDistance = distance
                    nearest = object 
                end
            end
        end
    end
    
    if nearest ~= nearestDisplayCache then
        nearestDisplayCache = nearest
        if nearestDisplayCache then
            for _, obj in ipairs(nearestDisplayCache:GetDescendants()) do
                processIfTexture(obj)
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        updateNearestDisplay()
    end
end)

local function isMyWeapon(obj)
    local current = obj
    local validContainer = nil

    while current and current ~= game do
        if current.Name == "Gun" or current.Name == "GunDisplay" or current.Name == "DisplayRefGun" then
            validContainer = current
            break
        end
        current = current.Parent
    end

    if not validContainer then return false end

    if validContainer.Name == "Gun" then
        if Player.Character and validContainer:IsDescendantOf(Player.Character) then return true end
        if Player:FindFirstChild("Backpack") and validContainer:IsDescendantOf(Player:FindFirstChild("Backpack")) then return true end
        if Camera and validContainer:IsDescendantOf(Camera) then return true end
        return false
    end

    if validContainer.Name == "GunDisplay" or validContainer.Name == "DisplayRefGun" then
        if Camera and validContainer:IsDescendantOf(Camera) then return true end
        if Player.Character and validContainer:IsDescendantOf(Player.Character) then return true end
        if nearestDisplayCache and (validContainer == nearestDisplayCache or validContainer:IsDescendantOf(nearestDisplayCache)) then return true end
        return false
    end

    return false
end

local function setTexture(obj, id)
	local value = "rbxassetid://" .. id
	if obj:IsA("MeshPart") then
		saveOriginal(obj, "TextureID")
		obj.TextureID = value
	elseif obj:IsA("SpecialMesh") then
		saveOriginal(obj, "TextureId")
		obj.TextureId = value
	end
end

function register(obj)
	if not isMyWeapon(obj) then return nil end

	if obj:IsA("SurfaceAppearance") or obj:IsA("Texture") or obj:IsA("Decal") then
		pcall(function() obj:Destroy() end)
		return nil
	end
	
	if not (obj:IsA("MeshPart") or obj:IsA("SpecialMesh")) then return nil end

	local scope = states.VoidScope and "VoidScope" or "MatrixScope"

	for _, data in ipairs(targets[scope]) do
		if data.Object == obj then return scope end
	end
	table.insert(targets[scope], {Object = obj})
	return scope
end

function apply(scope)
	local texId = (scope == "MatrixScope") and selectedTextureMatrix or selectedTextureVoid
	for i = #targets[scope], 1, -1 do
		local data = targets[scope][i]
		if not data.Object or not data.Object.Parent then
			table.remove(targets[scope], i)
		elseif states[scope] then
			setTexture(data.Object, texId)
		else
			restoreObject(data.Object)
		end
	end
end

