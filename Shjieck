local function getBeamEndpoints(beam)
    local a0 = beam.Attachment0; local a1 = beam.Attachment1
    if a0 and a1 then return a0.WorldPosition, a1.WorldPosition end
    if beam.Parent and beam.Parent:IsA("BasePart") then
        local pos = beam.Parent.Position
        return pos, pos + (beam.Parent.CFrame.LookVector * 100)
    end
    return nil, nil
end

local function processBeam(beam)
    if not (states.MatrixScope or states.VoidScope) then return end
    if not isNearOrMine(beam) then return end
    if not looksLikeShotBeam(beam) then return end
    if isKnifeObj(beam) then return end
    if beam.Transparency ~= NumberSequence.new(1) then pcall(function() beam.Transparency = NumberSequence.new(1) end) end
    local origin, endPos = getBeamEndpoints(beam)
    if not origin or not endPos then return end
    local dist = (origin - endPos).Magnitude
    if dist > 2 and beam.Enabled and (beam.Width0 > 0.01 or beam.Width1 > 0.01) then
        if not firingBeams[beam] then
            firingBeams[beam] = true
            drawCustomBeam(origin, endPos, beam)
            task.delay(0.15, function() firingBeams[beam] = nil end)
        end
    end
end

