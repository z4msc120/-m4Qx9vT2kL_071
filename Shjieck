local function setTexture(obj, id)
	local value = "rbxassetid://" .. id
	pcall(function()
		if obj:IsA("MeshPart") then
			saveOriginal(obj, "TextureID")
			obj.TextureID = value
		elseif obj:IsA("SpecialMesh") then
			saveOriginal(obj, "TextureId")
			obj.TextureId = value
		elseif obj:IsA("SurfaceAppearance") then
			saveOriginal(obj, "ColorMap")
			obj.ColorMap = value
		elseif obj:IsA("Texture") or obj:IsA("Decal") then
			saveOriginal(obj, "Texture")
			obj.Texture = value
		end
	end)
end

local function apply()
	local texId = nil
	if activeMode == "MatrixScope" then
		texId = selectedTextureMatrix
	elseif activeMode == "VoidScope" then
		texId = selectedTextureVoid
	end
	for i = #targets, 1, -1 do
		local data = targets[i]
		if not data.Object or not data.Object.Parent then
			if data.Object then targetObjects[data.Object] = nil end
			table.remove(targets, i)
		elseif texId then
			setTexture(data.Object, texId)
		else
			restoreObject(data.Object)
		end
	end
end

local OWNER_ATTRS = {
	"OwnerUserId","OwnerId","UserId","PlayerId",
	"Owner","Player","OwnerName","PlayerName",
	"DisplayOwner","Creator","CreatorId","User","Account","AccountId"
}

local function matchesPlayerValue(val)
	if val == nil then return false end
	if typeof(val) == "Instance" and val == Player then return true end
	if typeof(val) == "number" and val == Player.UserId then return true end
	if typeof(val) == "string" then
		if string.lower(val) == string.lower(Player.Name) then return true end
		if tonumber(val) == Player.UserId then return true end
	end
	return false
end

local function getOwnerFromAttributes(obj, maxDepth)
	local check = obj
	for _ = 1, maxDepth or 5 do
		if not check or check == game then break end
		for _, attrName in ipairs(OWNER_ATTRS) do
			if matchesPlayerValue(check:GetAttribute(attrName)) then return true end
		end
		check = check.Parent
	end
	return false
end

local function getOwnerFromValueChildren(obj)
	local check = obj
	for _ = 1, 3 do
		if not check or check == game then break end
		for _, child in ipairs(check:GetChildren()) do
			if child:IsA("ObjectValue") then
				local v = child.Value
				if v == Player then return true end
				if v and v:IsA("Model") and Players:GetPlayerFromCharacter(v) == Player then return true end
			elseif child:IsA("StringValue") then
				if string.lower(child.Value) == string.lower(Player.Name) then return true end
				if tonumber(child.Value) == Player.UserId then return true end
			elseif child:IsA("IntValue") or child:IsA("NumberValue") then
				if child.Value == Player.UserId then return true end
			end
		end
		check = check.Parent
	end
	return false
end

local function isMyGunPart(obj)
	local current = obj
	local validContainer, validName = nil, nil
	while current and current ~= game do
		if current.Name == "Gun" or current.Name == "GunDisplay" or current.Name == "DisplayRefGun" then
			validContainer = current
			validName = current.Name
			break
		end
		current = current.Parent
	end
	if not validContainer then return false end
	local character = Player.Character
	local backpack = Player:FindFirstChild("Backpack")
	if character and validContainer:IsDescendantOf(character) then return true end
	if backpack and validContainer:IsDescendantOf(backpack) then return true end
	if getOwnerFromAttributes(validContainer, 5) then return true end
	if getOwnerFromValueChildren(validContainer) then return true end
	local check = validContainer
	for _ = 1, 12 do
		if not check or check == game then break end
		local nm = string.lower(check.Name)
		if nm == string.lower(Player.Name) or nm == tostring(Player.UserId) then return true end
		check = check.Parent
	end
	if (validName == "GunDisplay" or validName == "DisplayRefGun") and character then
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			local displayPart = validContainer:IsA("BasePart") and validContainer
				or validContainer:FindFirstChildWhichIsA("BasePart", true)
			if displayPart then
				local dist = (displayPart.Position - root.Position).Magnitude
				if dist < 10 then
					local otherNearby = false
					for _, plr in ipairs(Players:GetPlayers()) do
						if plr ~= Player and plr.Character then
							local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
							if otherRoot and (otherRoot.Position - root.Position).Magnitude < 20 then
								otherNearby = true
								break
							end
						end
					end
					if not otherNearby then return true end
				end
			end
		end
	end
	return false
end

local function isMyBeam(obj)
	local character = Player.Character
	local backpack = Player:FindFirstChild("Backpack")
	if character and obj:IsDescendantOf(character) then return true end
	if backpack and obj:IsDescendantOf(backpack) then return true end
	local check = obj
	while check and check ~= game do
		if check.Name == "Gun" or check.Name == "GunDisplay" or check.Name == "DisplayRefGun" then
			if character and check:IsDescendantOf(character) then return true end
			if backpack and check:IsDescendantOf(backpack) then return true end
		end
		check = check.Parent
	end
	if obj:GetAttribute("OwnerUserId") == Player.UserId then return true end
	if obj.Parent and obj.Parent:GetAttribute("OwnerUserId") == Player.UserId then return true end
	if getOwnerFromAttributes(obj, 3) then return true end
	if getOwnerFromValueChildren(obj) then return true end
	if obj:IsA("Beam") or obj:IsA("Trail") then
		local root = character and character:FindFirstChild("HumanoidRootPart")
		for _, attProp in ipairs({"Attachment0", "Attachment1"}) do
			local att = obj[attProp]
			if att then
				if character and att:IsDescendantOf(character) then return true end
				if backpack and att:IsDescendantOf(backpack) then return true end
				local part = att.Parent
				if part and part:IsA("BasePart") and root then
					if (part.Position - root.Position).Magnitude < 25 then return true end
				end
			end
		end
	end
	return false
end

function register(obj)
	if not isMyGunPart(obj) then return false end
	if not (obj:IsA("MeshPart") or obj:IsA("SpecialMesh")
		or obj:IsA("SurfaceAppearance") or obj:IsA("Texture") or obj:IsA("Decal")) then
		return false
	end
	if targetObjects[obj] then return false end -- Búsqueda sin lag

	targetObjects[obj] = true
	table.insert(targets, {Object = obj})
	return true
end

local function isTextureLike(obj)
	return obj:IsA("MeshPart") or obj:IsA("SpecialMesh") or obj:IsA("SurfaceAppearance")
		or obj:IsA("Texture") or obj:IsA("Decal")
end

local function processIfTexture(obj)
	if isTextureLike(obj) then
		task.defer(function()
			pcall(function()
				if register(obj) then apply() end
			end)
		end)
	end
end

local function scanContainer(container)
	if not container then return end
	local ok, descendants = pcall(function() return container:GetDescendants() end)
	if not ok then return end
	for _, obj in ipairs(descendants) do
		if isTextureLike(obj) then
			pcall(register, obj)
		end
	end
end

local scanInProgress = false

local function scanWorkspaceAsync()
	if scanInProgress then return end
	scanInProgress = true
	task.spawn(function()
		pcall(function()
			local count = 0
			local ok, descendants = pcall(function() return Workspace:GetDescendants() end)
			if ok and descendants then
				for _, obj in ipairs(descendants) do
					if isTextureLike(obj) then
						pcall(register, obj)
						count = count + 1
						if count % 50 == 0 then -- Optimizado a 50 para evitar freeze completo
							task.wait()
						end
					end
				end
			end
		end)
		scanInProgress = false
		pcall(apply)
	end)
end

