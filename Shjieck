local selectedTextureVoid, selectedTrailColorVoid, selectedTrailColorVoid2, selectedTrailRainbowVoid = VOID_TEXTURES[1].ID, TRAIL_PRESETS[VOID_TEXTURES[1].Trail].Color, TRAIL_PRESETS[VOID_TEXTURES[1].Trail].Color2, false

local function getId(v) return tostring(v or ""):match("%d+") end
local function getTexture(obj)
	if obj:IsA("Texture") or obj:IsA("Decal") then return getId(obj.Texture)
	elseif obj:IsA("MeshPart") then return getId(obj.TextureID)
	elseif obj:IsA("SpecialMesh") then return getId(obj.TextureId)
	elseif obj:IsA("SurfaceAppearance") then return getId(obj.ColorMap) end
end

local function setTexture(obj, id)
	local value = "rbxassetid://" .. id
	if obj:IsA("Texture") or obj:IsA("Decal") then
		saveOriginal(obj, "Texture")
		obj.Texture = value
	elseif obj:IsA("MeshPart") then
		saveOriginal(obj, "TextureID")
		obj.TextureID = value
	elseif obj:IsA("SpecialMesh") then
		saveOriginal(obj, "TextureId")
		obj.TextureId = value
	elseif obj:IsA("SurfaceAppearance") then
		saveOriginal(obj, "ColorMap")
		obj.ColorMap = value
	end
end

local function findScope(obj)
	local id = getTexture(obj)
	for scope, originalId in pairs(ORIGINAL_IDS) do
		if id == originalId then return scope end
	end

	local c = obj
	local gunDisplay = nil
	while c and c ~= game do
		if c.Name == "GunDisplay" then gunDisplay = c break end
		c = c.Parent
	end
	
	if gunDisplay then
		for _, descendant in ipairs(gunDisplay:GetDescendants()) do
			local did = getTexture(descendant)
			for scope, originalId in pairs(ORIGINAL_IDS) do
				if did == originalId then return scope end
			end
		end
	end
end

local function isValidWeapon(obj)
	local c = obj
	local belongsToPlayer = false
	local isGun = false
	local isGunDisplay = false
	
	while c and c ~= game do
		if c == Player.Character or c == Player:FindFirstChild("Backpack") then
			belongsToPlayer = true
		end
		if c.Name == "Gun" then
			isGun = true
		elseif c.Name == "GunDisplay" then
			isGunDisplay = true
		end
		c = c.Parent
	end
	
	if isGunDisplay then return true end
	return belongsToPlayer and isGun
end

local function isInsideNonGunTool(obj)
	local c = obj.Parent
	while c and c ~= game do
		if c:IsA("Tool") then
			if c.Name ~= "Gun" then
				return true
			end
		end
		c = c.Parent
	end
	return false
end

local function register(obj)
	if not isValidWeapon(obj) then return nil end
	local scope = findScope(obj)
	if not scope and obj:FindFirstAncestor("GunDisplay") then
		scope = states.VoidScope and "VoidScope" or "MatrixScope"
	end
	if not scope then return nil end

	for _, data in ipairs(targets[scope]) do
		if data.Object == obj then return scope end
	end
	table.insert(targets[scope], {Object = obj, Original = ORIGINAL_IDS[scope]})
	return scope
end

local function apply(scope)
	local texId = (scope == "MatrixScope") and selectedTextureMatrix or selectedTextureVoid
	for i = #targets[scope], 1, -1 do
		local data = targets[scope][i]
		if not data.Object or not data.Object.Parent then
			table.remove(targets[scope], i)
		elseif states[scope] then
			setTexture(data.Object, texId)
		else
			restoreObject(data.Object)
		end
	end
end

