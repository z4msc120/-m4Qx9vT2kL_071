local RGB_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
})

local function colorBeamOrPart(obj, activeColor, activeRainbow)
    if obj:IsA("Beam") or obj:IsA("Trail") or obj:IsA("ParticleEmitter") then
        saveOriginal(obj, "Color")
        if activeRainbow then
            obj.Color = RGB_SEQUENCE
        else
            obj.Color = ColorSequence.new(activeColor)
        end
    elseif obj:IsA("BasePart") then
        saveOriginal(obj, "Color")
        if activeRainbow then
            obj.Color = Color3.fromRGB(math.random(100, 255), math.random(100, 255), math.random(100, 255))
        else
            obj.Color = activeColor
        end
    end
end

