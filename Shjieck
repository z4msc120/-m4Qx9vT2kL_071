local function processBeam(beam)
    if not beam or not beam.Parent then return end
    
    local isActive = states.MatrixScope or states.VoidScope
    local isMineOrClose = isNearOrMine(beam)
    
    if not isActive or not isMineOrClose then
        if originalBeamData[beam] then
            beam.Width0 = originalBeamData[beam].Width0
            beam.Width1 = originalBeamData[beam].Width1
            beam.Texture = originalBeamData[beam].Texture
            beam.Color = originalBeamData[beam].Color
            beam.LightEmission = originalBeamData[beam].LightEmission
            beam.LightInfluence = originalBeamData[beam].LightInfluence
            originalBeamData[beam] = nil
        end
        return
    end
    
    if not originalBeamData[beam] then
        originalBeamData[beam] = {
            Width0 = beam.Width0,
            Width1 = beam.Width1,
            Texture = beam.Texture,
            Color = beam.Color,
            LightEmission = beam.LightEmission,
            LightInfluence = beam.LightInfluence
        }
    end
    
    beam.Width0 = 0.15
    beam.Width1 = 0.15
    beam.Texture = CUSTOM_BEAM_TEXTURE
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Color = getBeamColor()
end

local function setupBeam(beam)
    allBeams[beam] = true
end

