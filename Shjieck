local function isAnotherPlayer(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and obj:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

local function isNearOrMine(obj)
    if isAnotherPlayer(obj) then return false end
    
    if Player.Character and obj:IsDescendantOf(Player.Character) then return true end
    if Player:FindFirstChild("Backpack") and obj:IsDescendantOf(Player:FindFirstChild("Backpack")) then return true end

    local char = Player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local pos
    if obj:IsA("BasePart") then
        pos = obj.Position
    elseif obj:IsA("Beam") or obj:IsA("Trail") then
        local a0 = obj.Attachment0
        if a0 and a0.Parent and a0.Parent:IsA("BasePart") then
            pos = a0.WorldPosition
        elseif obj.Parent and obj.Parent:IsA("BasePart") then
            pos = obj.Parent.Position
        end
    elseif obj:IsA("Attachment") and obj.Parent and obj.Parent:IsA("BasePart") then
        pos = obj.WorldPosition
    end

    if pos and (pos - hrp.Position).Magnitude <= MAX_DISTANCE then
        return true
    end
    return false
end

local function getId(v)
    return tostring(v or ""):match("%d+")
end

local function getTexture(obj)
    if obj:IsA("Texture") or obj:IsA("Decal") then
        return getId(obj.Texture)
    elseif obj:IsA("MeshPart") then
        return getId(obj.TextureID)
    elseif obj:IsA("SpecialMesh") then
        return getId(obj.TextureId)
    elseif obj:IsA("SurfaceAppearance") then
        return getId(obj.ColorMap)
    end
end

local function setTexture(obj, id)
    local value = "rbxassetid://" .. id
    if obj:IsA("Texture") or obj:IsA("Decal") then
        obj.Texture = value
    elseif obj:IsA("MeshPart") then
        obj.TextureID = value
    elseif obj:IsA("SpecialMesh") then
        obj.TextureId = value
    elseif obj:IsA("SurfaceAppearance") then
        obj.ColorMap = value
    end
end

local function findScope(obj)
    local id = getTexture(obj)
    for scope, originalId in pairs(ORIGINAL_IDS) do
        if id == originalId then return scope end
    end
end

local function register(obj)
    if not isNearOrMine(obj) then return end
    local scope = findScope(obj)
    if not scope then return end
    for _, data in ipairs(targets[scope]) do
        if data.Object == obj then return end
    end
    table.insert(targets[scope], {Object = obj, Original = ORIGINAL_IDS[scope]})
end

local function apply(scope)
    local texId
    if scope == "MatrixScope" then
        texId = selectedTextureMatrix
    else
        texId = selectedTextureVoid
    end

    for i = #targets[scope], 1, -1 do
        local data = targets[scope][i]
        local obj = data.Object
        if not obj or not obj.Parent or not isNearOrMine(obj) then
            table.remove(targets[scope], i)
        elseif states[scope] then
            setTexture(obj, texId)
        else
            setTexture(obj, data.Original)
        end
    end
end

local function getActiveTrail()
    if states.MatrixScope then
        if selectedTrailRainbowMatrix then return nil, true end
        local col = selectedTrailColorMatrix
        if typeof(col) ~= "ColorSequence" then col = ColorSequence.new(TRAIL_PURPLE) end
        return col, false
    elseif states.VoidScope then
        if selectedTrailRainbowVoid then return nil, true end
        local col = selectedTrailColorVoid
        if typeof(col) ~= "ColorSequence" then col = ColorSequence.new(TRAIL_VOID_CYAN) end
        return col, false
    end
    return nil, false
end

local function getBeamColor()
    local col, rainbow = getActiveTrail()
    if rainbow then
        return ColorSequence.new(Color3.fromHSV((tick() * 2) % 1, 1, 1))
    end
    return col or ColorSequence.new(Color3.fromRGB(255, 255, 255))
end

