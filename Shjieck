local RGB_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
})

local LASER_KEYWORDS = {"beam", "laser", "trail", "tracer", "shot", "line", "ray", "disparo", "bala"}
local function looksLikeShotBeam(beam)
	if not beam:IsA("Beam") then return false end
	local name = string.lower(beam.Name)
	for _, kw in ipairs(LASER_KEYWORDS) do
		if string.find(name, kw) then
			return true
		end
	end
	return false
end

local function changeBeamColor(beam)
	if not beam or not beam.Parent then return end
	if not looksLikeShotBeam(beam) then return end
	if not (states.MatrixScope or states.VoidScope) then return end
	if isInsideNonGunTool(beam) then return end

	local activeColor, activeRainbow = getActiveTrail()
	if not activeColor and not activeRainbow then return end

	saveOriginal(beam, "Color")

	if activeRainbow then
		beam.Color = RGB_SEQUENCE
	else
		beam.Color = ColorSequence.new(activeColor)
	end
end

local function monitorCharacter(char)
	if not char then return end
	for _, obj in ipairs(char:GetDescendants()) do
		register(obj)
	end
	char.DescendantAdded:Connect(function(obj)
		task.defer(function()
			local scope = register(obj)
			if scope then apply(scope) end
		end)
	end)
end

